<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <OutputType>Exe</OutputType>
  <TargetFramework>net10.0-windows</TargetFramework>
	<UseWindowsForms>true</UseWindowsForms>
  <RootNamespace>odctl</RootNamespace>
  <ImplicitUsings>enable</ImplicitUsings>
  <AssemblyName>odctl</AssemblyName>
  <Title>ODCtl for Windows</Title>
  <Description>OneDrive command-line control for Windows</Description>
  <AssemblyVersion>1.0.0.0</AssemblyVersion>
  <VersionPrefix>1.0.0</VersionPrefix>
  <VersionSuffix>stable-20261101-01</VersionSuffix>
  <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  <Company>Michelle Catherine Marcó</Company>
  <Copyright>Copyright © 2026 Michelle Catherine Marcó</Copyright>
  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  <PublishTrimmed>False</PublishTrimmed>
</PropertyGroup>

<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
  <WarningLevel>4</WarningLevel>
</PropertyGroup>

<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
  <WarningLevel>4</WarningLevel>
</PropertyGroup>

<ItemGroup>
  <PackageReference Include="System.CommandLine" Version="2.0.14" />
</ItemGroup>

</Project>
